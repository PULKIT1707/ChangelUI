# Dashboard analytics (PostHog). Copy this file to dashboard/.env.local and fill in real values.
# dashboard/.env.local is gitignored: never commit real values. This example file is tracked.
# Leave VITE_POSTHOG_KEY empty to build the dashboard with analytics disabled: no consent banner,
# no PostHog code is loaded and nothing is sent.

# Public project API key (starts with phc_). It is designed to ship in the browser bundle and is not
# a secret. Never put a personal API key (phx_...) here.
VITE_POSTHOG_KEY=

# Ingestion host. Must be an https URL, otherwise analytics stays disabled. EU Cloud by default.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
